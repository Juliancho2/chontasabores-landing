---
import type { Producto } from '../data/productos';
import CartIcon from './CartIcon.astro';
import { whatsappUrl } from '../data/site';

interface Props {
  producto: Producto;
}

const { producto: p } = Astro.props;
const first = p.formats[0];
---

<article class="card" data-fx="pop" data-name={p.title} data-wa={whatsappUrl} data-sel="0" data-qty="1">
  <div class="media" style={`background:${p.bg}`}>
    <img src={p.img} alt={p.alt} loading="lazy" />
  </div>
  <div class="body">
    <h3 class="display">{p.title}</h3>
    <p class="desc">{p.desc}</p>

    <!-- Presentaciones: al elegir una se actualiza precio, total y mensaje -->
    <div class="prices" role="group" aria-label={`Presentaciones de ${p.title}`}>
      {
        p.formats.map((f, k) => (
          <button
            type="button"
            class="fmt"
            data-size={f.size}
            data-unit={f.unit}
            data-mayor={f.mayor ?? ''}
            aria-pressed={k === 0 ? 'true' : 'false'}
          >
            <span class="row">
              <span class="size">{f.size}</span>
              <span class="dots" />
              <span class="unit display">{f.unit}</span>
            </span>
            {f.mayor && <span class="tiers">Por mayor desde 6 uds: {f.mayor} c/u</span>}
          </button>
        ))
      }
    </div>

    <!-- Pedido armado: cantidad + total + WhatsApp con el mensaje listo -->
    <div class="order">
      <div class="qty" role="group" aria-label="Cantidad de unidades">
        <button type="button" class="qty__btn" data-step="-1" aria-label="Quitar una unidad">−</button>
        <span class="qty__n" aria-live="polite">1</span>
        <button type="button" class="qty__btn" data-step="1" aria-label="Añadir una unidad">+</button>
      </div>

      <div class="total">
        <span class="total__label" data-mode>Precio unitario</span>
        <strong class="total__val display" data-total>{first.unit}</strong>
      </div>

      <button class="btn order__cta add" type="button">
        <CartIcon size={17} />Añadir al carrito
      </button>
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--card);
    border: 2.5px dashed rgba(42, 18, 48, 0.4);
    border-radius: 28px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .card:hover {
    transform: translateY(-8px) rotate(-0.5deg);
    box-shadow: 0 22px 40px rgba(42, 18, 48, 0.2);
    border-color: rgba(42, 18, 48, 0.75);
  }
  .media img {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .media img {
    transform: translateY(-10px) scale(1.06);
  }
  .media {
    height: 310px;
    border-radius: 18px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-top: 18px;
    overflow: hidden;
  }
  .media img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }
  .body {
    padding: 24px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }
  h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.05;
  }
  .desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    font-weight: 600;
    color: #4a2a52;
  }
  .prices {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: 6px;
  }

  /* Cada presentación es un botón elegible */
  .fmt {
    appearance: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    background: none;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 6px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .fmt:hover {
    background: rgba(63, 30, 109, 0.06);
  }
  .fmt[aria-pressed='true'] {
    border-color: rgba(42, 18, 48, 0.55);
    background: rgba(247, 135, 69, 0.16);
  }
  .fmt:focus-visible {
    outline: 3px solid var(--purple);
    outline-offset: 2px;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .size {
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }
  .dots {
    flex: 1 1 20px;
    min-width: 12px;
    border-bottom: 2px dotted rgba(42, 18, 48, 0.35);
    transform: translateY(-5px);
  }
  .unit {
    font-size: 19px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tiers {
    font-size: 11.5px;
    font-weight: 700;
    color: #6a4a70;
    font-variant-numeric: tabular-nums;
    margin-top: 2px;
  }

  /* Pedido: cantidad + total + CTA */
  .order {
    margin-top: 4px;
    padding-top: 14px;
    border-top: 2px dashed rgba(42, 18, 48, 0.3);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .qty {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--ink);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .qty__btn {
    width: 34px;
    height: 34px;
    border: 0;
    background: var(--kraft);
    color: var(--ink);
    font-size: 19px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .qty__btn:hover {
    background: var(--orange);
  }
  .qty__btn:focus-visible {
    outline: 3px solid var(--purple);
    outline-offset: -3px;
  }
  .qty__n {
    min-width: 32px;
    text-align: center;
    font-size: 15px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .total {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    margin-left: auto;
    text-align: right;
  }
  .total__label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #6a4a70;
  }
  .total__val {
    font-size: 22px;
    font-variant-numeric: tabular-nums;
  }
  .order__cta {
    flex: 1 1 100%;
    background: var(--purple);
    color: var(--paper);
    min-height: 46px;
    padding: 0 16px;
    font-size: 14px;
    border-radius: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .media img {
      transition: none !important;
    }
  }
</style>
