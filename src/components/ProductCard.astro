---
import type { Producto } from '../data/productos';

interface Props {
  producto: Producto;
}

const { producto: p } = Astro.props;
---

<article class="card">
  <div class="media" style={`background:${p.bg}`}>
    <img src={p.img} alt={p.alt} loading="lazy" />
  </div>
  <div class="body">
    <h3 class="display">{p.title}</h3>
    <p class="desc">{p.desc}</p>
    <div class="prices">
      {
        p.formats.map((f) => (
          <div>
            <div class="row">
              <span class="size">{f.size}</span>
              <span class="dots" />
              <span class="unit display">{f.unit}</span>
            </div>
            <div class="tiers">
              6–12 uds {f.mid} · 13+ uds {f.high}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--card);
    border: 2.5px dashed rgba(42, 18, 48, 0.4);
    border-radius: 28px;
    padding: 14px;
    display: flex;
    flex-direction: column;
  }
  .media {
    height: 310px;
    border-radius: 18px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-top: 18px;
    overflow: hidden;
  }
  .media img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }
  .body {
    padding: 24px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }
  h3 {
    margin: 0;
    font-size: 30px;
    line-height: 1.05;
  }
  .desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    font-weight: 600;
    color: #4a2a52;
  }
  .prices {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    padding-top: 6px;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .size {
    font-size: 14px;
    font-weight: 800;
  }
  .dots {
    flex: 1 1 20px;
    min-width: 12px;
    border-bottom: 2px dotted rgba(42, 18, 48, 0.35);
    transform: translateY(-5px);
  }
  .unit {
    font-size: 25px;
    font-variant-numeric: tabular-nums;
  }
  .tiers {
    font-size: 12.5px;
    font-weight: 700;
    color: #6a4a70;
    font-variant-numeric: tabular-nums;
    margin-top: 2px;
  }
</style>
