---
import Polaroid from './Polaroid.astro';
import WhatsappIcon from './WhatsappIcon.astro';
import { whatsappUrl, mailUrl } from '../data/site';
---

<section id="maquila" class="maquila">
  <div class="container inner">
    <div class="texto">
      <span class="hand kicker" data-fx="up">Para otros negocios</span>
      <h2 class="display" data-fx="words">Servicio de maquila</h2>
      <p data-fx="up">
        Fabricamos chontaduro en almíbar, mermelada de chontaduro, chontaduro en salmuera y harina de chontaduro, con
        alta calidad y a tu medida. Optimiza tus costos y mejora tu producción con un servicio eficiente y puntual.
      </p>
      <div class="actions">
        <a class="btn dark" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-fx="up"><WhatsappIcon size={20} />Cotiza tu maquila</a>
        <a class="btn light" href={mailUrl} data-fx="up">Escríbenos</a>
      </div>
    </div>
    <div class="foto">
      <Polaroid src="/images/fruta.jpg" alt="Chontaduro rojo recién cosechado" caption="Fruta de nuestra tierra" rotate={2.5} aspect="4/3" />
    </div>
  </div>
</section>

<style>
  .maquila {
    background: var(--orange);
    padding-block: 104px;
  }
  .inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 56px;
    align-items: center;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .kicker {
    font-size: 26px;
    color: var(--ink);
  }
  h2 {
    margin: 0;
    font-size: clamp(33px, 4.4vw, 66px);
    line-height: 1;
  }
  p {
    margin: 0;
    max-width: 560px;
    font-size: 16.5px;
    line-height: 1.75;
    font-weight: 700;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 6px;
  }
  .dark {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 4px 0 rgba(42, 18, 48, 0.5);
  }
  .light {
    background: var(--card);
    color: var(--ink);
  }
  .foto {
    width: 100%;
    max-width: 440px;
    justify-self: center;
  }
</style>
