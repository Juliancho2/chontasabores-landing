---
import { whatsappUrl } from '../data/site';

const links = [
  { href: '#historia', label: 'Nuestra historia' },
  { href: '#productos', label: 'Productos' },
  { href: '#campo', label: 'El campo' },
  { href: '#maquila', label: 'Maquila' },
];
---

<header class="header container">
  <a href="#inicio" class="logo display" aria-label="Chonta Sabores, inicio">
    Chonta <span>Sabores</span>
  </a>
  <nav class="links" aria-label="Principal">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a class="btn cta" href={whatsappUrl}>Pedir por WhatsApp</a>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 22px;
  }
  .logo {
    font-size: 30px;
    color: var(--ink);
  }
  .logo span {
    color: var(--coral);
  }
  .links {
    display: flex;
    gap: 30px;
    align-items: center;
  }
  .links a {
    font-weight: 700;
    font-size: 16px;
    padding: 14px 6px;
  }
  .links a:hover {
    color: var(--coral);
  }
  .cta {
    background: var(--orange);
    color: var(--ink);
    min-height: 46px;
    padding: 0 22px;
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
  }
</style>
