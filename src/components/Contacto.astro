---
import WhatsappIcon from "./WhatsappIcon.astro";
import SocialLinks from "./SocialLinks.astro";
import { site, whatsappUrl, mailUrl } from "../data/site";
---

<footer id="contacto" class="contacto">
  <div class="container inner">
    <div class="top">
      <div class="title">
        <span class="hand kicker" data-fx="up">Te esperamos</span>
        <h2 class="display" data-fx="words">¡Haz tu pedido hoy mismo!</h2>
      </div>
      <div class="datos">
        <a class="btn phone" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-fx="up"
          ><WhatsappIcon size={26} />Pedir por WhatsApp
        </a>
        <a class="mail" href={mailUrl} data-fx="up">{site.email}</a>
        <span class="dir" data-fx="up">
          <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7Zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2Z" /></svg>
          {site.address}
        </span>
        <div class="redes" data-fx="up">
          <SocialLinks hover="ink" />
        </div>
      </div>
    </div>
    <div class="bottom" data-fx="up">
      <span class="display brand">{site.name}</span>
      <span class="tag">{site.tagline}</span>
    </div>
  </div>
</footer>

<style>
  .contacto {
    background: var(--coral);
    color: var(--ink);
    padding-block: 72px 36px;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }
  .title {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 760px;
  }
  .kicker {
    font-size: 22px;
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.9vw, 56px);
    line-height: 1;
  }
  .datos {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .phone {
    background: var(--ink);
    color: var(--paper);
    font-size: 19px;
    min-height: 66px;
    padding: 0 38px;
    box-shadow: 0 4px 0 rgba(42, 18, 48, 0.5);
  }
  .mail {
    font-weight: 800;
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 5px;
    padding: 12px 4px;
  }
  .dir {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 15.5px;
    font-weight: 800;
    padding: 4px 4px;
  }
  .dir svg {
    flex: none;
    font-size: 17px;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border-top: 2px dashed rgba(42, 18, 48, 0.5);
    padding-top: 26px;
  }
  .brand {
    font-size: 18px;
  }
  .tag {
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
