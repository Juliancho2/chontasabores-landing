  tiktok: `<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M16.32 3h-2.9v12.1a2.44 2.44 0 1 1-2.44-2.44c.25 0 .49.04.73.12V9.8a5.6 5.6 0 0 0-.73-.05 5.5 5.5 0 1 0 5.5 5.5V8.7a7.3 7.3 0 0 0 4.27 1.37V7.14A4.42 4.42 0 0 1 16.32 3Z"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M13.6 21v-8.03h2.7l.4-3.13h-3.1V7.87c0-.9.25-1.52 1.55-1.52h1.66V3.54c-.29-.04-1.28-.13-2.44-.13-2.41 0-4.06 1.47-4.06 4.18v2.25H7.56v3.13h2.73V21h3.31Z"/></svg>`,
};
---

<ul class:list={['social', hover === 'ink' && 'h-ink']}>
  {
    social.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
          <span set:html={icons[s.name.toLowerCase()]} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--card);
    color: var(--ink);
    border: 2.5px solid var(--ink);
    box-shadow: 0 4px 0 rgba(42, 18, 48, 0.9);
    font-size: 19px;
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .social a > span {
    display: inline-flex;
    line-height: 0;
  }
  .social a:hover {
    transform: translateY(-3px) rotate(-5deg);
    background: var(--coral);
    color: var(--paper);
  }
  .social.h-ink a:hover {
    background: var(--ink);
    color: var(--orange);
  }
  .social a:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 rgba(42, 18, 48, 0.9);
  }
</style>
