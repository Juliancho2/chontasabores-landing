---
import { social } from '../data/site';

interface Props {
  /** Color del hover: `coral` (sobre fondo lila) o `ink` (sobre fondo coral). */
  hover?: 'coral' | 'ink';
}

const { hover = 'coral' } = Astro.props;

/** Glifos en línea: el tamaño y el color los hereda del enlace (1em/currentColor). */
const icons: Record<string, string> = {
