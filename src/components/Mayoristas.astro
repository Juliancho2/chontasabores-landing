---
import WhatsappIcon from './WhatsappIcon.astro';
import { waLink } from '../data/site';

const mayoreoUrl = waLink(
  '¡Hola, Chonta Sabores! 🌴 Soy de un negocio (tienda, restaurante o distribuidor) y quiero cotizar precios al por mayor: desde 6 unidades y la bolsa de harina de 12 kilos. ¿Me pasan la tabla y la disponibilidad?',
);

const beneficios = [
  'Desde 6 unidades',
  'Harina en bolsa de 12 kilos',
  'Despacho desde Popayán',
  'Sin aditivos ni conservantes',
];
---

<section id="mayoreo" class="mayoreo">
  <div class="container inner">
    <div class="title">
      <span class="hand kicker" data-fx="up">Tiendas, restaurantes y revendedores</span>
      <h2 class="display" data-fx="words">Vende Chonta Sabores en tu negocio</h2>
    </div>

    <p class="lead" data-fx="up">
      Precios al por mayor desde 6 unidades, presentaciones de 500 ml, 250 ml y 130 ml, y harina en bolsa de 12 kilos.
      Cotizamos tu pedido y lo despachamos desde Popayán.
    </p>

    <ul class="lista">
      {beneficios.map((b) => <li data-fx="up">{b}</li>)}
    </ul>

    <a class="btn dark" href={mayoreoUrl} target="_blank" rel="noopener noreferrer" data-fx="up">
      <WhatsappIcon size={20} />Cotiza tu pedido al por mayor
    </a>
  </div>
</section>

<style>
  .mayoreo {
    background: var(--kraft);
    border-block: 2.5px dashed rgba(42, 18, 48, 0.4);
    padding-block: 64px;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .title {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .kicker {
    font-size: 21px;
    color: var(--purple);
  }
  h2 {
    margin: 0;
    font-size: clamp(28px, 3.3vw, 46px);
    line-height: 1.04;
    max-width: 18ch;
  }
  .lead {
    margin: 0;
    max-width: 64ch;
    font-size: 16px;
    line-height: 1.65;
    font-weight: 600;
    color: #4a2a52;
  }
  .lista {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 4px 0;
    padding: 0;
    list-style: none;
  }
  .lista li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--card);
    border: 2px dashed rgba(42, 18, 48, 0.45);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 13.5px;
    font-weight: 800;
  }
  .lista li::before {
    content: '✓';
    color: var(--coral);
    font-weight: 900;
  }
  .dark {
    background: var(--purple);
    color: var(--paper);
  }

  @media (max-width: 760px) {
    .mayoreo {
      padding-block: 48px;
    }
    h2 {
      font-size: clamp(26px, 7vw, 34px);
      max-width: none;
    }
    .lead {
      font-size: 15px;
    }
  }
</style>
